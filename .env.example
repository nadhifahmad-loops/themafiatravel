# Copy to .env for Docker Compose or .env.local for `npm run dev`.
# Replace every placeholder. Never commit real environment files.

# Docker Compose PostgreSQL. Keep this password in sync with both URLs below.
POSTGRES_DB=mafia_travel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:URL_ENCODE_PASSWORD@db:5432/mafia_travel?schema=public
DIRECT_URL=postgresql://postgres:URL_ENCODE_PASSWORD@db:5432/mafia_travel?schema=public

# Public application origin (use the same canonical HTTPS origin in production).
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate unique random values; do not reuse these between environments.
NEXTAUTH_SECRET=replace-with-a-random-secret
TICKET_VERIFY_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes

# Orbisway supplier credentials.
ORBISWAY_BASE_URL=https://apiinternal.orbisway.com
ORBISWAY_USER=
ORBISWAY_PASSWORD=
ORBISWAY_API_KEY=

# Midtrans. Keep server and browser environment/mode aligned.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Required while Google sign-in is enabled in the auth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin bootstrap/seed credentials. Use a unique strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin TMT

# Required for protected Vercel Cron endpoints in production.
CRON_SECRET=

# Recommended in production so rate limits are shared across instances.
REDIS_URL=

# Penyimpanan upload (banner admin, cover koleksi). WAJIB di produksi: disk
# lokal tidak bisa dipakai di Vercel/Docker. Isi ketiganya atau kosongkan semua.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hanya dev: host tunnel (mis. ngrok) yang boleh mengakses dev server, pisahkan dengan koma.
ALLOWED_DEV_ORIGINS=

# Optional integrations.
RESEND_API_KEY=
EMAIL_FROM=
FONNTE_API_TOKEN=
NEXT_PUBLIC_WHATSAPP_SUPPORT=
REFUND_AUTO_MAX=500000
