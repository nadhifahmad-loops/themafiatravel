# Database - PostgreSQL connection strings
DATABASE_URL="postgresql://user:password@localhost:5432/mafia_travel?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Orbisway API
ORBISWAY_BASE_URL=https://apiinternal.orbisway.com
ORBISWAY_USER=your_orbisway_user
ORBISWAY_PASSWORD=your_orbisway_password
ORBISWAY_API_KEY=your_orbisway_api_key

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key
MIDTRANS_IS_PRODUCTION=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key

# Refund — ambang nominal auto-refund untuk tipe 'flight' (default: 500000).
# Nilai di bawah ambang diproses otomatis, di atas masuk antrian review admin.
# Insurance & train selalu auto; hotel selalu review manual.
# REFUND_AUTO_MAX=500000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# WhatsApp (Fonnte API) — untuk OTP verifikasi nomor telepon
# GANTI dengan token milikmu (dari dashboard Fonnte). Jangan commit token asli.
FONNTE_API_TOKEN=your_fonnte_api_token

# Admin seed (wajib diisi sebelum `npm run db:seed` / prisma db seed)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=strong-admin-password-change-me

# Rate limiter — opsional; bila kosong memakai in-memory (hilang saat restart)
# REDIS_URL=redis://localhost:6379
